# Backend
PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/datainvestments"
SESSION_SECRET=change-this-to-a-random-secret-in-production

# API Keys (get free keys from each service)
FINNHUB_API_KEY=your_finnhub_api_key_here
SEC_USER_AGENT=DataInvestments admin@datainvestments.com

# Google OAuth (get from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Stripe (secret key + webhook signing secret — price IDs live in the Plan table)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# PostgreSQL (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=datainvestments
