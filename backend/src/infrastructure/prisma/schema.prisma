generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(uuid())
  ticker      String   @unique
  name        String
  sector      String?
  industry    String?
  description String?
  cik         String?
  ceo         String?
  employees   Int?
  country     String?
  exchange    String?
  website     String?
  ipoDate     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  financialData  FinancialData[]
  stockMetrics   StockMetric[]
  balanceSheets  BalanceSheet[]
  segments       RevenueSegment[]
  dataSync       DataSync?
  favorites      Favorite[]
  alarms         Alarm[]
}

model FinancialData {
  id       String  @id @default(uuid())
  companyId String
  year     Int
  quarter  Int?

  // Ingresos
  revenue       Float
  costOfRevenue Float
  grossProfit   Float?

  // Gastos operativos
  operatingExpenses Float
  sgaExpense        Float
  rdExpense         Float

  // Otros gastos
  interestExpense Float
  taxExpense      Float

  // EBITDA / EBIT
  ebitda Float?
  ebit   Float?

  // Inversión y amortización
  capex        Float
  depreciation Float

  // Cash flow
  operatingCashFlow  Float?
  investingCashFlow  Float?
  financingCashFlow  Float?
  freeCashFlow       Float?
  dividendsPaid      Float?
  shareRepurchases   Float?

  // Balance sheet basics
  totalAssets     Float?
  totalLiabilities Float?
  totalEquity     Float?

  // Resultado
  netIncome Float

  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year, quarter])
}

model BalanceSheet {
  id       String  @id @default(uuid())
  companyId String
  year     Int
  quarter  Int?

  // Activos corrientes
  cashAndCashEquivalents Float?
  shortTermInvestments   Float?
  accountsReceivable     Float?
  inventory              Float?
  totalCurrentAssets     Float?

  // Activos no corrientes
  propertyPlantEquipment Float?
  goodwill               Float?
  intangibleAssets       Float?
  totalNonCurrentAssets  Float?
  totalAssets            Float?

  // Pasivos corrientes
  accountsPayable         Float?
  shortTermDebt           Float?
  totalCurrentLiabilities Float?

  // Pasivos no corrientes
  longTermDebt              Float?
  totalNonCurrentLiabilities Float?
  totalLiabilities          Float?

  // Patrimonio
  totalStockholdersEquity Float?
  retainedEarnings        Float?
  treasuryStock           Float?

  createdAt DateTime @default(now())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year, quarter])
}

model RevenueSegment {
  id       String  @id @default(uuid())
  companyId String
  year     Int
  quarter  Int?

  segmentName String
  segmentType String    // "product" | "geography"
  revenue     Float
  percentage  Float?

  createdAt DateTime @default(now())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year, quarter, segmentName, segmentType])
}

model StockMetric {
  id       String   @id @default(uuid())
  companyId String
  date     DateTime

  currentPrice    Float
  peRatio         Float?
  pbRatio         Float?
  psRatio         Float?
  dividendYield   Float?
  marketCap       Float?
  enterpriseValue Float?

  // Shares
  sharesOutstanding Float?

  // Profitability
  roe   Float?
  roa   Float?
  roic  Float?

  // Financial strength
  currentRatio   Float?
  debtToEquity   Float?
  altmanZ        Float?
  piotroskiScore Float?

  // Valoración intrínseca
  intrinsicValue Float?
  marginOfSafety Float?

  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model DataSync {
  id           String   @id @default(uuid())
  companyId    String   @unique
  lastSyncAt   DateTime
  yearsFetched Int
  fmpSync      Boolean  @default(false)
  secSync      Boolean  @default(false)
  finnhubSync  Boolean  @default(false)
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("user")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  favorites Favorite[]
  sessions  Session[]
  alarms    Alarm[]
}

model Session {
  id       String   @id @default(uuid())
  sid      String   @unique
  data     Json
  expireAt DateTime

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

model Favorite {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  @@unique([userId, companyId])
}

model Alarm {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  targetVerdict String    // 'buy' | 'hold' | 'sell'
  lastVerdict   String?   // último veredicto computeado
  lastPrice     Float?    // último precio checkeado
  lastCheckedAt DateTime? // última verificación
  triggered     Boolean   @default(false)

  @@unique([userId, companyId])
}
