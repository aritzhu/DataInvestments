generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(uuid())
  ticker      String   @unique
  name        String
  sector      String?
  industry    String?
  description String?
  cik         String?
  ceo         String?
  employees   Int?
  country     String?
  exchange    String?
  currency    String?
  website     String?
  logoUrl     String?
  ipoDate     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  financialData  FinancialData[]
  stockMetrics   StockMetric[]
  balanceSheets  BalanceSheet[]
  segments       RevenueSegment[]
  dataSync       DataSync?
  favorites      Favorite[]
  alarms         Alarm[]
  holdings       Holding[]
}

model FinancialData {
  id       String  @id @default(uuid())
  companyId String
  year     Int
  quarter  Int?

  revenue       Float
  costOfRevenue Float
  grossProfit   Float?

  operatingExpenses Float
  sgaExpense        Float
  rdExpense         Float

  interestExpense Float
  taxExpense      Float

  ebitda Float?
  ebit   Float?

  capex        Float
  depreciation Float

  operatingCashFlow  Float?
  investingCashFlow  Float?
  financingCashFlow  Float?
  freeCashFlow       Float?
  dividendsPaid      Float?
  shareRepurchases   Float?

  totalAssets     Float?
  totalLiabilities Float?
  totalEquity     Float?

  netIncome Float

  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year, quarter])
}

model BalanceSheet {
  id       String  @id @default(uuid())
  companyId String
  year     Int
  quarter  Int?

  cashAndCashEquivalents Float?
  shortTermInvestments   Float?
  accountsReceivable     Float?
  inventory              Float?
  totalCurrentAssets     Float?

  propertyPlantEquipment Float?
  goodwill               Float?
  intangibleAssets       Float?
  totalNonCurrentAssets  Float?
  totalAssets            Float?

  accountsPayable         Float?
  shortTermDebt           Float?
  totalCurrentLiabilities Float?

  longTermDebt              Float?
  totalNonCurrentLiabilities Float?
  totalLiabilities          Float?

  totalStockholdersEquity Float?
  retainedEarnings        Float?
  treasuryStock           Float?

  createdAt DateTime @default(now())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year, quarter])
}

model RevenueSegment {
  id       String  @id @default(uuid())
  companyId String
  year     Int
  quarter  Int?

  segmentName String
  segmentType String
  revenue     Float
  percentage  Float?

  createdAt DateTime @default(now())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year, quarter, segmentName, segmentType])
}

model StockMetric {
  id       String   @id @default(uuid())
  companyId String
  date     DateTime

  currentPrice    Float
  peRatio         Float?
  pbRatio         Float?
  psRatio         Float?
  dividendYield   Float?
  marketCap       Float?
  enterpriseValue Float?

  sharesOutstanding Float?

  roe   Float?
  roa   Float?
  roic  Float?

  currentRatio   Float?
  debtToEquity   Float?
  altmanZ        Float?
  piotroskiScore Float?

  intrinsicValue Float?
  marginOfSafety Float?

  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
}

model DataSync {
  id           String   @id @default(uuid())
  companyId    String   @unique
  lastSyncAt   DateTime
  yearsFetched Int
  secSync       Boolean  @default(false)
  finnhubSync   Boolean  @default(false)
  europeanSync  Boolean  @default(false)
  errorMessage  String?
  availableTags String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("user")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  favorites  Favorite[]
  alarms     Alarm[]
  portfolios Portfolio[]
}

model Favorite {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  @@unique([userId, companyId])
}

model Alarm {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  targetVerdict String
  lastVerdict   String?
  lastPrice     Float?
  lastCheckedAt DateTime?
  triggered     Boolean   @default(false)

  @@unique([userId, companyId])
}

model Portfolio {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings Holding[]

  @@index([userId])
}

model Holding {
  id          String   @id @default(uuid())
  portfolioId String
  companyId   String
  quantity    Decimal
  averageCost Decimal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, companyId])
  @@index([portfolioId])
  @@index([companyId])
}

model FieldConfig {
  id         String   @id @default(uuid())
  fieldName  String
  source     String
  customTags String[]
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([fieldName, source])
}

model ConceptMapping {
  id          String   @id @default(uuid())
  conceptName String   @unique
  fieldName   String
  source      String
  confirmedBy String?
  createdAt   DateTime @default(now())
}

model SiteSetting {
  key       String   @id
  value     String?
  updatedAt DateTime @updatedAt
}
