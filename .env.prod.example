# Production environment variables
# Copy this to .env.prod and fill in real values
# Or configure as GitHub Secrets (recommended)

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=datainvestments

# Auto-constructed by docker-compose:
# DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/datainvestments

SESSION_SECRET=CHANGE_ME_to_a_random_64_char_string

FINNHUB_API_KEY=your_finnhub_api_key_here
SEC_USER_AGENT=DataInvestments admin@datainvestments.com

NODE_ENV=production
