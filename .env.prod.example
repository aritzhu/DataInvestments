# Production environment variables
# Copy this to .env.prod and fill in real values
# Or configure as GitHub Secrets (recommended)

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=datainvestments

# Auto-constructed by docker-compose:
# DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/datainvestments

SESSION_SECRET=CHANGE_ME_to_a_random_64_char_string

FINNHUB_API_KEY=your_finnhub_api_key_here
SEC_USER_AGENT=DataInvestments admin@datainvestments.com

# Set to "true" to enable Secure cookie flag (required when behind HTTPS)
COOKIE_SECURE=true

NODE_ENV=production

# Google OAuth (get from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Stripe (secret key + webhook signing secret — price IDs live in the Plan table)
STRIPE_SECRET_KEY=sk_live_or_sk_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Frontend public URL (used for Stripe Checkout success/cancel redirects)
CLIENT_URL=https://your-domain.com
